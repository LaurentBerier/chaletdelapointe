{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./schema": "./src/schema/index.js"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts && pnpm run apply-invariants",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts && pnpm run apply-invariants",
    "apply-invariants": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f ./migrations/001_reservation_invariants.sql"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9"
  }
}
